# Database
UNIDOC_DB_URL=jdbc:mysql://localhost:3306/unidoc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
UNIDOC_DB_USERNAME=unidoc_app
UNIDOC_DB_PASSWORD=replace_me

# JWT
UNIDOC_JWT_SECRET=replace_with_base64_32_byte_secret
UNIDOC_JWT_EXPIRATION_SECONDS=3600

# Browser/API
UNIDOC_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
UNIDOC_FRONTEND_URL=http://localhost:5173

# Storage
UNIDOC_STORAGE_ROOT=./data/uploads
UNIDOC_SUPPORTING_MAX_BYTES=5242880
UNIDOC_ISSUED_MAX_BYTES=10485760

# Email
UNIDOC_EMAIL_ENABLED=false
UNIDOC_EMAIL_FROM=
UNIDOC_SMTP_HOST=smtp.gmail.com
UNIDOC_SMTP_PORT=587
UNIDOC_SMTP_USERNAME=
UNIDOC_SMTP_APP_PASSWORD=
UNIDOC_SMTP_AUTH=true
UNIDOC_SMTP_STARTTLS=true

# Demo
UNIDOC_SEED_DEMO=true
UNIDOC_RESET_DEMO=false
UNIDOC_RESET_CONFIRMATION=
